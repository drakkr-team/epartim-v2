@layout.email()
    @slot("header")
        <mj-text font-size="32px" font-family="{{ fonts.serif }}" align="center" color="{{ colors.primary[11]["light"] }}" padding="0">
            Activez votre compte
        </mj-text>
    @end

    @slot("content")
        <mj-text font-size="14px" font-family="{{ fonts.sans }}" color="{{ colors.neutral[12]["light"] }}" line-height="1.5">
            Bonjour <strong>{{ user.name }}</strong>,
        </mj-text>

        <mj-text font-size="14px" font-family="{{ fonts.sans }}" color="{{ colors.neutral[12]["light"] }}" line-height="1.5">
            Un administrateur vous a invité à rejoindre Epartim. Définissez votre mot de passe pour activer votre compte.
        </mj-text>

        <mj-spacer />

        @!component("components/email/button", { url: activationUrl, text: "Activer mon compte" })

        <mj-spacer />

        <mj-text font-size="14px" font-family="{{ fonts.sans }}" color="{{ colors.neutral[12]["light"] }}" line-height="1.5">
            Si le bouton ne fonctionne pas, copiez-collez ce lien dans votre navigateur : <a href="{{ activationUrl }}" style="color: {{ colors.primary[9]["light"] }};">{{ activationUrl }}</a>
        </mj-text>
    @end

    @slot("footer")
        <mj-text font-size="12px" font-family="{{ fonts.sans }}" color="{{ colors.neutral[11]["light"] }}" line-height="1.5">
            Ce lien est valable pendant <strong>7 jours</strong>. S'il a expiré ou ne fonctionne plus, contactez votre administrateur afin qu'il vous envoie une nouvelle invitation.
        </mj-text>
    @end
@end
