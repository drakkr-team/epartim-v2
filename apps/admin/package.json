{
	"name": "@workspace/admin",
	"author": "drakkar",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"postinstall": "pnpm run i18n:build",
		"build": "vite build",
		"preview": "vite preview",
		"dev": "portless",
		"dev:default": "concurrently --prefix none \"vite dev\" \"pnpm:i18n:dev\"",
		"typecheck": "tsc --noEmit",
		"i18n:build": "node scripts/compile-locales.js",
		"i18n:dev": "nodemon scripts/compile-locales.js --watch '**/locales/**/*.json' -e json -q"
	},
	"portless": {
		"name": "admin.epartim",
		"script": "dev:default"
	},
	"dependencies": {
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-pacer": "0.23.0",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-router-ssr-query": "1.167.2",
		"@tanstack/react-start": "1.168.49",
		"@tanstack/react-table": "9.2.4",
		"@tanstack/router-plugin": "1.168.35",
		"@tuyau/core": "1.2.2",
		"@tuyau/react-query": "1.1.0",
		"@tuyau/superjson": "1.0.0",
		"@workspace/api": "workspace:*",
		"@workspace/ui-react": "workspace:*",
		"@workspace/ui-theme": "workspace:*",
		"i18next": "26.4.0",
		"next-themes": "0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-i18next": "17.0.12",
		"react-intersection-observer": "11.0.1",
		"tailwind-variants": "3.3.1",
		"zod": "4.5.4",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "0.2.3",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/react-devtools": "0.10.12",
		"@tanstack/react-form-devtools": "0.2.34",
		"@tanstack/react-query-devtools": "5.102.8",
		"@tanstack/react-router-devtools": "1.167.1",
		"@types/node": "24",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"concurrently": "10.0.5",
		"deepmerge-json": "1.5.0",
		"nodemon": "3.1.14",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.2.2"
	}
}
