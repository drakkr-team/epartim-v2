{
	"name": "@workspace/admin",
	"author": "drakkar",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"postinstall": "pnpm run i18n:merge",
		"build": "vite build",
		"preview": "vite preview",
		"dev": "portless",
		"dev:app": "vite dev",
