{
	"name": "@workspace/ui-react",
	"private": true,
	"type": "module",
	"exports": {
		"./components/*": "./src/components/*/index.ts",
		"./icons": "./src/icons.ts",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"dev": "portless",
		"dev:default": "storybook dev --no-open",
		"typecheck": "tsc --noEmit"
	},
	"portless": {
		"name": "ui.epartim",
		"script": "dev:default"
	},
	"peerDependencies": {
		"@workspace/ui-theme": "workspace:*",
		"react": "19",
		"react-dom": "19",
		"tailwindcss": "4"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"lucide-react": "1.34.0",
		"sonner": "2.0.7",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "0.2.3",
		"@storybook/addon-docs": "10.5.7",
		"@storybook/addon-themes": "10.5.7",
		"@storybook/react-vite": "10.5.7",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"storybook": "10.5.7",
		"typescript": "6.0.3",
		"vite": "8.2.1"
	}
}
